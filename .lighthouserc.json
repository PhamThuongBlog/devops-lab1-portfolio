{
  "ci": {
    // 1. TẬP HỢP DỮ LIỆU AUDIT (COLLECT)
    "collect": {
      // Chỉ định thư mục chứa các file web tĩnh (HTML/CSS/JS) để Lighthouse trực tiếp quét và kiểm thử
      "staticDistDir": "./",
      
      // Số lần chạy test lặp lại cho mỗi trang (mặc định chạy 1 lần để tiết kiệm thời gian CI/CD)
      "numberOfRuns": 1
    },

    // 2. RÀNG BUỘC CÁC TIÊU CHÍ ĐÁNH GIÁ (ASSERT)
    "assert": {
      // Thiết lập các quy tắc điểm số tối thiểu cho từng danh mục
      "assertions": {
        // Kiểm tra Performance (Hiệu năng): Nếu điểm < 0.7 (70/100) sẽ bắn cảnh báo ("warn")
        "categories:performance": ["warn", { "minScore": 0.7 }],

        // Kiểm tra Accessibility (Khả năng truy cập): Nếu điểm < 0.8 (80/100) sẽ báo lỗi ("error") và ngắt pipeline
        "categories:accessibility": ["error", { "minScore": 0.8 }],

        // Kiểm tra Best Practices (Tiêu chuẩn lập trình tối ưu): Nếu điểm < 0.8 (80/100) sẽ bắn cảnh báo ("warn")
        "categories:best-practices": ["warn", { "minScore": 0.8 }],

        // Kiểm tra SEO (Tối ưu hóa công cụ tìm kiếm): Nếu điểm < 0.8 (80/100) sẽ bắn cảnh báo ("warn")
        "categories:seo": ["warn", { "minScore": 0.8 }]
      }
    },

    // 3. XUẤT VÀ LƯU TRỮ BÁO CÁO (UPLOAD)
    "upload": {
      // Tải kết quả audit lên kho lưu trữ tạm thời miễn phí của Google 
      // (Hệ thống sẽ trả về đường link xem báo cáo HTML trực quan trên GitHub Actions)
      "target": "temporary-public-storage"
    }
  }
}
